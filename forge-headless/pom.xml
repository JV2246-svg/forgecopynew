<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-headless</artifactId>
    <name>Forge Headless</name>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!-- changelog RSS feed; only forge.util.RSSReader touches it and nothing headless calls that -->
                <exclusion>
                    <groupId>com.apptasticsoftware</groupId>
                    <artifactId>rssreader</artifactId>
                </exclusion>
                <!-- io.sentry must stay on the classpath: forge-game/forge-ai classes import it
                     for breadcrumbs. It is inert because forge.headless.Main never calls
                     Sentry.init (no-op hub, no network). Replace with a no-op stub jar when
                     jar size matters (iOS AOT phase). -->
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <attach>false</attach>
                    <descriptors>
                        <!-- custom descriptor keeps META-INF/services intact (tinylog), same as forge-gui-desktop -->
                        <descriptor>src/main/assembly/jar-with-dependencies.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifest>
                            <mainClass>forge.headless.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
